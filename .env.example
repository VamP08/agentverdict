# AgentVerdict environment configuration.
# Copy this file to .env and uncomment/adjust values as needed.
# All settings use the AGENTVERDICT_ prefix (see src/agentverdict/config.py).

# --- Database ---------------------------------------------------------------
# Default: a local SQLite file in the working directory. No variables needed.
# AGENTVERDICT_DATABASE_URL=sqlite:///./agentverdict.db

# Postgres started via docker-compose (`docker compose up -d db`):
AGENTVERDICT_DATABASE_URL=postgresql+psycopg://agentverdict:agentverdict@localhost:5432/agentverdict

# --- Misc -------------------------------------------------------------------
# Enable debug mode (default: false).
# AGENTVERDICT_DEBUG=false
